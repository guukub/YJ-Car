// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// NextAuth Required Models
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("STAFF")
  accounts      Account[]
  sessions      Session[]
  jobsAssigned  JobQueue[] @relation("StaffJobs")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Business Models

model Customer {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  phone         String    @unique
  lineId        String?
  email         String?
  address       String?
  totalSpent    Float     @default(0)
  visitCount    Int       @default(0)
  notes         String?
  vehicles      Vehicle[]
  jobs          JobQueue[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Vehicle {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  licensePlate  String    @unique
  brand         String
  model         String
  color         String
  type          String // SEDAN, SUV, etc.
  currentMileage String?
  chassisNo     String?
  customerId    String @db.ObjectId
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs          JobQueue[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Service {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  price         Float
  category      String    // e.g., WASH, COATING, INTERIOR
  jobs          JobService[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model JobQueue {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  queueNumber   Int       @unique
  date          DateTime
  timeIn        DateTime
  appointmentAt DateTime?
  status        String    @default("WAITING")
  notes         String?
  
  customerId    String @db.ObjectId
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  vehicleId     String @db.ObjectId
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  
  staffId       String? @db.ObjectId
  staff         User?     @relation("StaffJobs", fields: [staffId], references: [id], onDelete: SetNull)
  
  services      JobService[]
  images        JobImage[]
  
  totalPrice    Float     @default(0)
  discount      Float     @default(0)
  netPrice      Float     @default(0)
  
  paymentStatus String    @default("UNPAID") // UNPAID, DEPOSIT, PAID
  amountPaid    Float     @default(0)
  paymentMethod String?   // CASH, TRANSFER
  
  warranty      String?   // Added for warranty period
  warrantyEnd   DateTime? // Expiration date for warranty
  isPromotion   Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model JobService {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  jobId         String @db.ObjectId
  job           JobQueue  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  serviceId     String @db.ObjectId
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  priceAtTime   Float
  
  @@unique([jobId, serviceId])
}

model JobImage {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  url           String
  type          String    // BEFORE, AFTER, SCRATCH, RECEIPT
  jobId         String @db.ObjectId
  job           JobQueue  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
}

model Expense {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  category      String
  amount        Float
  date          DateTime
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Setting {
  id String @id @map("_id") @default("global")
  promptPayId   String?
  lineToken     String?
  shopName      String    @default("YJ Cars Detailing")
  openTime      String    @default("08:00")
  closeTime     String    @default("20:00")
  updatedAt     DateTime  @updatedAt
}
